        <mxCell id="ingest" value="&lt;b&gt;Ingest Lambda&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#5E6C84&quot;&gt;webhook.py · GitHub HMAC / Datadog shared-secret validation&lt;br&gt;normalize.py · any source → shared alert schema&lt;br&gt;dedup.py · fingerprint suppression · 5-minute service window&lt;br&gt;open alerts group · recovery closes the match or is dropped&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE2CC;strokeColor=#FF8B00;strokeWidth=2;fontSize=13;fontColor=#172B4D;" vertex="1" parent="1"><mxGeometry x="430" y="405" width="345" height="110" as="geometry"/></mxCell>
