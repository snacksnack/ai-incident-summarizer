        <mxCell id="dlq" value="&lt;b&gt;SQS dead-letter queue&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#5E6C84&quot;&gt;Failed EventBridge deliveries · 14 days&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#FF9900;dashed=1;fontSize=12;fontColor=#172B4D;" vertex="1" parent="1"><mxGeometry x="215" y="350" width="250" height="58" as="geometry"/></mxCell>
